GIT_SECRETS_VERSION="1.3.0"

###
### Build control file for the git-secrets port
###

###
### Required Environment Variables
###
export ZOPEN_PROJECT_NAME="git-secrets"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/awslabs/git-secrets/archive/refs/tags/${GIT_SECRETS_VERSION}.tar.gz"
export ZOPEN_STABLE_DEPS="make bash git curl coreutils grep"
export ZOPEN_DEV_URL="https://github.com/awslabs/git-secrets.git"
export ZOPEN_DEV_DEPS="make bash git curl"
export ZOPEN_CATEGORIES="security development language ai core utilities editor source_control"
export ZOPEN_RUNTIME_DEPS="git bash curl"
# export ZOPEN_SYSTEM_PREREQ="zos25" # optional system pre-req (default=zos25)
export ZOPEN_RUNTIME_DEPS="git bash"

# No ./configure script
export ZOPEN_CONFIGURE="skip"

# No compilation needed — pure shell script, skip the build phase
export ZOPEN_MAKE="skip"

# Install directly via make, pointing PREFIX at zopen's managed directory
export ZOPEN_INSTALL="make"
export ZOPEN_INSTALL_OPTS="install PREFIX=\${ZOPEN_INSTALL_DIR}"

# The Makefile has no 'check' target — correct target is 'test' (needs bats)
# Skip for now until bats port is available
export ZOPEN_CHECK_OPTS="test"
export ZOPEN_CONFIGURE_MINIMAL="y"
export ZOPEN_MAKE_MINIMAL="y"
export ZOPEN_CHECK_MINIMAL="y"
export ZOPEN_INSTALL_MINIMAL="y"

