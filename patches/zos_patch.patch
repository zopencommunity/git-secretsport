 # Performs a regular grep, taking into account patterns and recursion.
 # Note: this function returns 1 on success, 0 on error.
 regular_grep() {
-  local files=("${@}") patterns=$(load_patterns) action='skip'
+  local patterns=$(load_patterns)
   [ -z "${patterns}" ] && return 1
-  [ ${RECURSIVE} -eq 1 ] && action="recurse"
-  GREP_OPTIONS= LC_ALL=C grep -d "${action}" -nwHEI "${patterns}" "${files[@]}"
+  # Emulate -w using POSIX ERE word boundaries (z/OS grep has no -w/\b/[[:<:]])
+  # Map "-" to /dev/stdin (z/OS grep does not treat "-" as stdin)
+  # Append /dev/null to force filename:line output for single files (-H not on z/OS)
+  local files=()
+  for f in "${@}"; do
+    [ "$f" = "-" ] && files+=("/dev/stdin") || files+=("$f")
+  done
+  local pattern_args=()
+  while IFS= read -r p; do
+    [ -n "$p" ] && pattern_args+=(-e "(^|[^[:alnum:]_])(${p})([^[:alnum:]_]|$)")
+  done <<< "${patterns}"
+  if [ ${RECURSIVE} -eq 1 ]; then
+    GREP_OPTIONS= LC_ALL=C grep -r -nE "${pattern_args[@]}" "${files[@]}" /dev/null
+  else
+    GREP_OPTIONS= LC_ALL=C grep -nE "${pattern_args[@]}" "${files[@]}" /dev/null
+  fi
 }
 
