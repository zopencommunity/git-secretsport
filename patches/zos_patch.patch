 INITIAL_HOME=${HOME}
 
+# z/OS safe recursive remove: only runs if directory exists.
+# Avoids rm -rf which z/OS does not support as a combined flag.
+zos_rmdir() {
+  local dir="$1"
+  [ -d "$dir" ] || return 0
+  find "$dir" -depth -type f -exec rm -f {} \; 2>/dev/null || true
+  find "$dir" -depth -type l -exec rm -f {} \; 2>/dev/null || true
+  find "$dir" -depth -type d -exec rmdir {} \; 2>/dev/null || true
+}
+
 setup() {
   setup_repo
-  [ -d "${TEMPLATE_DIR}" ] && rm -rf "${TEMPLATE_DIR}"
-  [ -d "${TEMP_HOME}" ] && rm -rf "${TEMP_HOME}"
+  zos_rmdir "${TEMPLATE_DIR}"
+  zos_rmdir "${TEMP_HOME}"
   mkdir -p $TEMP_HOME
   export HOME=$TEMP_HOME
   export PATH="${BATS_TEST_DIRNAME}/..:${INITIAL_PATH}"
@@ -19,18 +29,18 @@ teardown() {
